{
  "k": "el",
  "tag": "h_flex",
  "style": {
    "display": "flex",
    "flexDirection": "row",
    "alignItems": "center",
    "width": "100%",
    "height": "100%",
    "paddingLeft": 12,
    "paddingRight": 12,
    "rowGap": 8,
    "columnGap": 8,
    "backgroundColor": "#282c34",
    "borderBottomWidth": 1,
    "borderColor": "#3a3f4b",
    "fontSize": 12,
    "borderStyle": "solid"
  },
  "children": [
    {
      "k": "el",
      "tag": "div",
      "style": {
        "width": 12,
        "flexGrow": 0,
        "flexShrink": 0,
        "flexBasis": "auto",
        "color": "#5c6370"
      },
      "children": [
        {
          "k": "text",
          "style": {},
          "text": "·"
        }
      ]
    },
    {
      "k": "el",
      "tag": "div",
      "style": {
        "overflowX": "hidden",
        "overflowY": "hidden",
        "textOverflow": "ellipsis",
        "whiteSpace": "nowrap",
        "fontWeight": 600,
        "color": "#abb2bf"
      },
      "children": [
        {
          "k": "text",
          "style": {},
          "text": ""
        }
      ]
    },
    {
      "k": "el",
      "tag": "div",
      "style": {
        "flexGrow": 1,
        "flexShrink": 1,
        "flexBasis": "0%"
      }
    },
    {
      "k": "el",
      "tag": "div",
      "id": "keep",
      "style": {
        "paddingLeft": 8,
        "paddingRight": 8,
        "paddingTop": 2,
        "paddingBottom": 2,
        "borderTopLeftRadius": 5,
        "borderTopRightRadius": 5,
        "borderBottomRightRadius": 5,
        "borderBottomLeftRadius": 5,
        "color": "#7f848e",
        "cursor": "pointer"
      },
      "states": {
        "hover": {
          "backgroundColor": "#2f343e",
          "color": "#abb2bf"
        }
      },
      "on": {
        "click": 1
      },
      "children": [
        {
          "k": "text",
          "style": {},
          "text": "↗ keep"
        }
      ]
    },
    {
      "k": "el",
      "tag": "div",
      "id": "close",
      "style": {
        "paddingLeft": 8,
        "paddingRight": 8,
        "paddingTop": 2,
        "paddingBottom": 2,
        "borderTopLeftRadius": 5,
        "borderTopRightRadius": 5,
        "borderBottomRightRadius": 5,
        "borderBottomLeftRadius": 5,
        "color": "#7f848e",
        "cursor": "pointer"
      },
      "states": {
        "hover": {
          "backgroundColor": "#2f343e",
          "color": "#abb2bf"
        }
      },
      "on": {
        "click": 2
      },
      "children": [
        {
          "k": "text",
          "style": {},
          "text": "✕"
        }
      ]
