{
  "k": "el",
  "tag": "h_flex",
  "id": "toast",
  "style": {
    "display": "flex",
    "flexDirection": "row",
    "alignItems": "center",
    "width": "100%",
    "height": "100%",
    "paddingLeft": 18,
    "paddingRight": 18,
    "rowGap": 12,
    "columnGap": 12,
    "backgroundColor": "#2c313a",
    "cursor": "pointer"
  },
  "states": {
    "hover": {
      "backgroundColor": "#2f343e"
    }
  },
  "on": {
    "click": 1
  },
  "children": [
    {
      "k": "el",
      "tag": "div",
      "style": {
        "width": 8,
        "height": 8,
        "borderTopLeftRadius": 4,
        "borderTopRightRadius": 4,
        "borderBottomRightRadius": 4,
        "borderBottomLeftRadius": 4,
        "flexGrow": 0,
        "flexShrink": 0,
        "flexBasis": "auto",
        "backgroundColor": "#61afef"
      }
    },
    {
      "k": "el",
      "tag": "v_flex",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "flexGrow": 1,
        "flexShrink": 1,
        "flexBasis": "0%",
        "overflowX": "hidden",
        "overflowY": "hidden"
      },
      "children": [
        {
          "k": "el",
          "tag": "div",
          "style": {
            "overflowX": "hidden",
            "overflowY": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap",
            "fontWeight": 600,
            "fontSize": 13,
            "color": "#abb2bf"
          },
          "children": [
            {
              "k": "text",
              "style": {},
              "text": "Notice"
            }
          ]
        }
      ]
    }
  ]
}
