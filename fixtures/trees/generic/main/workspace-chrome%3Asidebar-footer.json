{
  "k": "el",
  "tag": "v_flex",
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "width": "100%",
    "height": "100%",
    "backgroundColor": "#1e2227",
    "borderTopWidth": 1,
    "borderColor": "#3a3f4b",
    "paddingLeft": 8,
    "paddingRight": 8,
    "paddingTop": 4,
    "paddingBottom": 8,
    "fontSize": 13,
    "borderStyle": "solid"
  },
  "children": [
    {
      "k": "el",
      "tag": "h_flex",
      "id": "settings",
      "style": {
        "display": "flex",
        "flexDirection": "row",
        "alignItems": "center",
        "height": 28,
        "paddingLeft": 8,
        "paddingRight": 8,
        "rowGap": 9,
        "columnGap": 9,
        "borderTopLeftRadius": 8,
        "borderTopRightRadius": 8,
        "borderBottomRightRadius": 8,
        "borderBottomLeftRadius": 8,
        "color": "#7f848e",
        "cursor": "pointer"
      },
      "states": {
        "hover": {
          "backgroundColor": "#2f343e",
          "color": "#abb2bf"
        }
      },
      "on": {
        "click": 1
      },
      "children": [
        {
          "k": "svg",
          "src": "mods/workspace-chrome/settings.svg",
          "style": {
            "width": 14,
            "height": 14
          }
        },
        {
          "k": "text",
          "style": {},
          "text": "Settings"
        }
      ]
    },
    {
      "k": "el",
      "tag": "h_flex",
      "id": "machine",
      "style": {
        "display": "flex",
        "flexDirection": "row",
        "alignItems": "center",
        "height": 28,
        "paddingLeft": 8,
        "paddingRight": 8,
        "rowGap": 9,
        "columnGap": 9,
        "borderTopLeftRadius": 8,
        "borderTopRightRadius": 8,
        "borderBottomRightRadius": 8,
        "borderBottomLeftRadius": 8,
        "color": "#5c6370",
        "cursor": "pointer"
      },
      "states": {
        "hover": {
          "backgroundColor": "#2f343e",
          "color": "#abb2bf"
        }
      },
      "on": {
        "click": 2
      },
      "children": [
        {
          "k": "svg",
          "src": "mods/workspace-chrome/plus.svg",
          "style": {
            "width": 14,
            "height": 14
          }
        },
        {
          "k": "text",
          "style": {},
          "text": "Add machine"
        }
      ]
    }
