    "width": "100%",
    "height": "100%",
    "paddingTop": 16,
    "paddingRight": 16,
    "paddingBottom": 16,
    "paddingLeft": 16,
    "rowGap": 10,
    "columnGap": 10,
    "backgroundColor": "#2c313a",
