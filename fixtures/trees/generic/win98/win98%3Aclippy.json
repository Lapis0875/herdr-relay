{
  "k": "el",
  "tag": "v_flex",
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "paddingTop": 4,
    "paddingRight": 4,
    "paddingBottom": 4,
    "paddingLeft": 4,
    "rowGap": 2,
    "columnGap": 2,
    "alignItems": "flex-start",
    "fontFamily": "Pixelated MS Sans Serif",
    "fontSize": 11,
    "lineHeight": "13px",
    "color": "#000000"
  },
  "children": [
    {
      "k": "el",
      "tag": "div",
      "id": "clippy",
      "style": {
        "position": "relative",
        "flexGrow": 0,
        "flexShrink": 0,
        "flexBasis": "auto",
        "cursor": "pointer"
      },
      "on": {
        "click": 1,
        "mousedown": {
          "left": 2
        }
      },
      "children": [
        {
          "k": "image",
          "src": "mods/win98/img/clippy.svg",
          "style": {
            "width": 64,
            "height": 80
          }
        }
      ]
    }
  ]
}
