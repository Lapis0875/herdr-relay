[
  {
    "$schema": "../../protocol/schema/policy-profile.schema.json",
    "id": "herdr-shipped",
    "description": "Herdr's shipped mods (0.1.14): git reads and the changes commit (U1), hc reads, links opened on the device, the files listing (Herdr's own literal, pinned per Herdr version); reads the space folders and appHome icons. worktree and machine-add have their own profiles below.",
    "folders": [
      "agents",
      "changes",
      "confirm",
      "files",
      "help",
      "menu",
      "new-menu",
      "pane",
      "peek",
      "picker",
      "prompt",
      "spaces",
      "tabs",
      "terminals-bar",
      "terminals-pane",
      "toast",
      "win98",
      "workspace-chrome",
      "workspace-status"
    ],
    "requires": { "herdr": ">=0.1.13" },
    "reads": {
      "appHome": ["data/{folder}/**", "icons/**", "my-icons/**", "layouts/*.svg"],
      "spaces": true
    },
    "exec": { "rows": ["E4", "E5", "E6", "E7", "E11", "E14"] },
    "shLiterals": {
      "a3163594cfb779a6a5beefd7c0aeb4a6838b8fce63061c24c245bbb6513d4231": "listing"
    },
    "overlay": "device"
  },
  {
    "$schema": "../../protocol/schema/policy-profile.schema.json",
    "id": "herdr-shipped-worktree",
    "description": "Herdr's worktree dialog (0.1.14): git reads, including its submodule checks through --git-dir and config --file/--blob, every path under the read roots. git worktree add/remove are refused with a toast (use the Herdr window).",
    "folders": ["worktree"],
    "requires": { "herdr": ">=0.1.13" },
    "reads": {
      "appHome": ["data/{folder}/**", "icons/**", "my-icons/**", "layouts/*.svg"],
      "spaces": true
    },
    "exec": { "rows": ["E4"], "git": { "gitDirUnderRoots": true } },
    "overlay": "device"
  },
  {
    "$schema": "../../protocol/schema/policy-profile.schema.json",
    "id": "herdr-shipped-machine-add",
    "description": "Herdr's Add machine dialog (0.1.14): adding a machine is a change only the Herdr window makes, so opening it on a device shows a toast instead; nothing runs.",
    "folders": ["machine-add"],
    "requires": { "herdr": ">=0.1.13" },
    "reads": {
      "appHome": ["data/{folder}/**", "icons/**", "my-icons/**", "layouts/*.svg"],
      "spaces": true
    },
    "exec": { "rows": ["E6", "E7"] },
    "overlay": "host-only"
  }
]
