{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:herdr-relay:schema:recorded-tree",
  "title": "RecordedTree (mod host render record)",
  "$ref": "#/$defs/RecordedNode",
  "$defs": {
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "RecordedCall": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "minItems": 1
    },
    "RecordedElement": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "handlers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedHandler"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedNode"
          }
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "states": {
          "$ref": "#/$defs/RecordedStates"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RecordedElement"
          }
        },
        "props": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "tag",
        "style",
        "handlers",
        "children"
      ],
      "additionalProperties": false
    },
    "RecordedHandler": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "required": [
        "event",
        "id"
      ],
      "additionalProperties": false
    },
    "RecordedNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordedElement"
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "entity"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RecordedStates": {
      "type": "object",
      "properties": {
        "hover": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "focus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "range_style": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "cell_style": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "cell_active_style": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        },
        "caret_style": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedCall"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
